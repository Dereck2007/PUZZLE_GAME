@model MathPuzzle.Web.Models.Pregunta

@{
    ViewData["Title"] = "Desafío matemático";

    int numeroPregunta = ViewBag.NumeroPregunta;
    int totalPreguntas = ViewBag.TotalPreguntas;
    int puntaje = ViewBag.Puntaje;

    string jugador = ViewBag.Jugador ?? "Jugador";

    double tiempoRestante = Convert.ToDouble(
        ViewBag.TiempoRestante
    );

    double progreso = totalPreguntas > 0
        ? (double)(numeroPregunta - 1) / totalPreguntas * 100
        : 0;

    string tiempoInicial = tiempoRestante.ToString(
        "0.###",
        System.Globalization.CultureInfo.InvariantCulture
    );
}

<section class="partida">

    <div class="partida-contenedor">

        <!-- ENCABEZADO -->
        <div class="partida-encabezado">

            <div class="partida-jugador">
                <span class="partida-etiqueta">
                    JUGADOR
                </span>

                <h2>@jugador</h2>
            </div>

            <div class="partida-puntuacion">
                <span class="partida-etiqueta">
                    PUNTUACIÓN ACTUAL
                </span>

                <strong>@puntaje</strong>
                <span>PTS</span>
            </div>

        </div>

        <!-- PROGRESO -->
        <div class="partida-progreso">

            <div class="partida-progreso-texto">
                <span>
                    PREGUNTA @numeroPregunta DE @totalPreguntas
                </span>

                <span>
                    DESAFÍO MATEMÁTICO
                </span>
            </div>

            <div class="partida-progreso-fondo">
                <div class="partida-progreso-barra"
                     style="width: @(progreso.ToString(
                                             "0.##",
                                             System.Globalization.CultureInfo.InvariantCulture
                                          ))%">
                </div>
            </div>

        </div>

        <!-- TARJETA DE PREGUNTA -->
        <div class="partida-tarjeta">

            <div class="partida-superior">

                <span class="partida-categoria">
                    MATH PUZZLE
                </span>

                <div class="partida-tiempo"
                     id="contenedor-tiempo">

                    <span class="partida-reloj">◷</span>

                    <strong id="tiempo">15</strong>

                    <span>SEG</span>

                </div>

            </div>

            <p class="partida-instruccion">
                SELECCIONA LA RESPUESTA CORRECTA
            </p>

            <h1 class="partida-pregunta">
                @Model.Enunciado
            </h1>

            <!-- OPCIONES -->
            <div class="partida-opciones">

                @for (int i = 0; i < Model.Opciones.Count; i++)
                {
                    <button type="button"
                            class="partida-opcion"
                            data-indice="@i">

                        <span class="partida-opcion-letra">
                            @((char)('A' + i))
                        </span>

                        <span class="partida-opcion-texto">
                            @Model.Opciones[i]
                        </span>

                        <span class="partida-opcion-flecha"
                              aria-hidden="true">
                            →
                        </span>

                    </button>
                }

            </div>

            <!-- FORMULARIO DE RESPUESTA -->
            <form id="form-respuesta"
                  asp-controller="Juego"
                  asp-action="Responder"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="idPregunta"
                       value="@Model.Id" />

                <input type="hidden"
                       id="indiceRespuesta"
                       name="indiceRespuesta"
                       value="-1" />

            </form>

            <!-- TEMPORIZADOR VISUAL -->
            <div class="partida-tiempo-barra">
                <div id="barra-tiempo"></div>
            </div>

        </div>

        <p class="partida-mensaje">
            Cada respuesta correcta suma 100 puntos.
            Si el tiempo se agota, avanzarás automáticamente.
        </p>

    </div>

</section>

<style>

    /* =====================================
           CONTENEDOR PRINCIPAL
           ===================================== */

    .partida {
        min-height: 85vh;
        padding: 70px 20px;
        background: linear-gradient( 120deg, #f5f0e8 0%, #ebdfcb 100% );
    }

    .partida-contenedor {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
    }

    /* ENCABEZADO */

    .partida-encabezado {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
    }

    .partida-etiqueta {
        display: block;
        font-size: 11px;
        letter-spacing: 2px;
        color: #987b50;
        margin-bottom: 10px;
    }

    .partida-jugador h2 {
        font-size: 25px;
        color: #14212b;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .partida-puntuacion {
        text-align: right;
    }

        .partida-puntuacion strong {
            font-size: 30px;
            color: #14212b;
        }

        .partida-puntuacion > span:last-child {
            font-size: 12px;
            color: #a7834e;
            margin-left: 5px;
        }

    /* PROGRESO */

    .partida-progreso {
        margin-bottom: 25px;
    }

    .partida-progreso-texto {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        color: #987b50;
        font-size: 11px;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
    }

    .partida-progreso-fondo {
        height: 5px;
        background: #ddceb6;
        border-radius: 10px;
        overflow: hidden;
    }

    .partida-progreso-barra {
        height: 100%;
        background: #a7834e;
        transition: width 0.4s ease;
    }

    /* TARJETA PRINCIPAL */

    .partida-tarjeta {
        background: #ffffff;
        border: 1px solid #e2d5c0;
        border-radius: 12px;
        padding: clamp(25px, 5vw, 50px);
        box-shadow: 0 15px 45px rgba( 20, 33, 43, 0.07 );
    }

    .partida-superior {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 45px;
    }

    .partida-categoria {
        font-size: 12px;
        color: #a7834e;
        letter-spacing: 2px;
    }

    /* TEMPORIZADOR */

    .partida-tiempo {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        border: 1px solid #ddceb6;
        background: #faf8f4;
        border-radius: 6px;
        color: #14212b;
    }

    .partida-reloj {
        font-size: 22px;
        color: #a7834e;
    }

    .partida-tiempo strong {
        font-size: 25px;
    }

    .partida-tiempo > span:last-child {
        font-size: 11px;
        color: #987b50;
    }

    .partida-tiempo.urgente {
        background: #fff0ed;
        border-color: #c95443;
        color: #c95443;
    }

        .partida-tiempo.urgente .partida-reloj {
            color: #c95443;
        }

    /* PREGUNTA */

    .partida-instruccion {
        color: #a7834e;
        font-size: 11px;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }

    .partida-pregunta {
        color: #14212b;
        font-size: clamp(26px, 4vw, 38px);
        font-weight: 500;
        line-height: 1.4;
        margin-bottom: 40px;
    }

    /* OPCIONES */

    .partida-opciones {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 40px;
    }

    .partida-opcion {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        border: 1px solid #e2d5c0;
        border-radius: 7px;
        background: #faf8f4;
        color: #14212b;
        font-family: Georgia, 'Times New Roman', serif;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
        min-width: 0;
    }

        .partida-opcion:hover {
            border-color: #a7834e;
            background: #f1e8d9;
            transform: translateY(-2px);
        }

        .partida-opcion:focus-visible {
            outline: 2px solid #a7834e;
            outline-offset: 3px;
        }

        .partida-opcion:disabled {
            cursor: default;
            opacity: 0.7;
            transform: none;
        }

    .partida-opcion-letra {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e9ddca;
        border-radius: 5px;
        color: #a7834e;
        font-size: 16px;
        flex-shrink: 0;
    }

    .partida-opcion-texto {
        flex: 1;
        font-size: 17px;
        overflow-wrap: anywhere;
    }

    .partida-opcion-flecha {
        color: #a7834e;
        font-size: 20px;
    }

    /* BARRA DEL TIEMPO */

    .partida-tiempo-barra {
        height: 5px;
        background: #e9ddca;
        border-radius: 10px;
        overflow: hidden;
    }

    #barra-tiempo {
        width: 100%;
        height: 100%;
        background: #a7834e;
        transition: width 0.1s linear;
    }

    .partida-mensaje {
        text-align: center;
        margin-top: 25px;
        color: #777777;
        font-size: 13px;
        line-height: 1.7;
    }

    /* DISEÑO RESPONSIVE */

    @@media (max-width: 650px) {

        .partida {
            padding: 35px 15px;
        }

        .partida-opciones {
            grid-template-columns: 1fr;
        }

        .partida-superior {
            margin-bottom: 30px;
        }

        .partida-progreso-texto {
            font-size: 9px;
        }

        .partida-tarjeta {
            padding: 25px 20px;
        }
    }

</style>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const tiempoInicial = parseFloat(
            "@tiempoInicial"
        );

        const duracionTotal = 15;

        const elementoTiempo =
            document.getElementById("tiempo");

        const contenedorTiempo =
            document.getElementById("contenedor-tiempo");

        const barraTiempo =
            document.getElementById("barra-tiempo");

        const formulario =
            document.getElementById("form-respuesta");

        const campoRespuesta =
            document.getElementById("indiceRespuesta");

        const opciones =
            document.querySelectorAll(".partida-opcion");

        let enviado = false;

        const inicioCliente = Date.now();

        // Enviar la respuesta al controlador.
        function enviarRespuesta(indice) {

            if (enviado) {
                return;
            }

            enviado = true;

            campoRespuesta.value = indice;

            opciones.forEach(function (opcion) {
                opcion.disabled = true;
            });

            formulario.requestSubmit();
        }

        // Seleccionar una respuesta.
        opciones.forEach(function (opcion) {

            opcion.addEventListener("click", function () {

                const indice = parseInt(
                    opcion.dataset.indice,
                    10
                );

                enviarRespuesta(indice);

            });

        });

        // Actualizar el temporizador.
        function actualizarTiempo() {

            if (enviado) {
                return;
            }

            const transcurrido =
                (Date.now() - inicioCliente) / 1000;

            const restante = Math.max(
                0,
                tiempoInicial - transcurrido
            );

            elementoTiempo.textContent =
                Math.ceil(restante);

            const porcentaje = Math.max(
                0,
                restante / duracionTotal * 100
            );

            barraTiempo.style.width =
                porcentaje + "%";

            // Cambiar el estilo durante los últimos segundos.
            if (restante <= 5) {

                contenedorTiempo.classList.add(
                    "urgente"
                );

                barraTiempo.style.backgroundColor =
                    "#c95443";

            }

            // Avanzar automáticamente cuando termine.
            if (restante <= 0) {

                clearInterval(intervalo);

                // -1 significa que no respondió.
                enviarRespuesta(-1);

            }
        }

        const intervalo = setInterval(
            actualizarTiempo,
            100
        );

        actualizarTiempo();

    });

</script>