<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Math Puzzle</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Estilos principales -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/secuencias.css"
          asp-append-version="true" />

    <!-- Estilos de Razor -->
    <link rel="stylesheet"
          href="~/MathPuzzle.Web.styles.css"
          asp-append-version="true" />

</head>

<body class="math-layout">

    <!-- =====================================
         MENÚ DE NAVEGACIÓN
         ===================================== -->

    <header>
        <nav class="navbar navbar-expand-sm navbar-light math-navbar">

            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand math-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <span>∑</span> MATH PUZZLE

                </a>

                <!-- Menú para celulares -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Enlaces -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <!-- RANKING -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Ranking"
                               asp-action="Index">
                                Ranking
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Secuencias"
                               asp-action="Index">
                                Secuencias
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Contrarreloj"
                               asp-action="Index">
                                Contrarreloj
                            </a>
                        </li>

                        <!-- EQUIPO -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="equipo">
                                Equipo
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- =====================================
         CONTENIDO PRINCIPAL
         ===================================== -->

    <div class="container-fluid p-0 math-main">

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <!-- =====================================
         PIE DE PÁGINA
         ===================================== -->

    <footer class="math-footer">

        <div class="container text-center">

            <p class="mb-0">
                &copy; @DateTime.Now.Year - Math Puzzle
            </p>

            <p class="mb-0">
                Proyecto de Programación Avanzada
            </p>

        </div>

    </footer>

    <!-- =====================================
         SCRIPTS
         ===================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>