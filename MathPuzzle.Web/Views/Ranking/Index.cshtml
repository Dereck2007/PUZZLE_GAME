@model List<MathPuzzle.Web.Models.Partida>

@{
    ViewData["Title"] = "Ranking de jugadores";
}

<section class="ranking">

    <div class="ranking-contenedor">

        <!-- ENCABEZADO -->
        <div class="ranking-encabezado">

            <div class="ranking-icono">
                ∑
            </div>

            <p class="ranking-etiqueta">
                MATH PUZZLE · CLASIFICACIÓN
            </p>

            <h1>
                SALÓN DE
                <span>LOS MEJORES</span>
            </h1>

            <p class="ranking-descripcion">
                La lógica, la rapidez y el conocimiento
                definen a los mejores jugadores.
                Descubre quiénes lideran el desafío.
            </p>

        </div>

        @if (Model == null || Model.Count == 0)
        {
            <!-- RANKING VACÍO -->
            <div class="ranking-vacio">

                <div class="ranking-vacio-icono">
                    ∑
                </div>

                <h2>Aún no hay resultados</h2>

                <p>
                    Todavía no se han registrado partidas.
                    ¡Sé el primero en aparecer en el ranking!
                </p>

                <a asp-controller="Juego"
                   asp-action="Index"
                   class="ranking-boton">

                    COMENZAR A JUGAR
                    <span aria-hidden="true">→</span>

                </a>

            </div>
        }
        else
        {
            <!-- TRES PRIMEROS LUGARES -->
            <div class="ranking-seccion-titulo">

                <p>LOS MEJORES JUGADORES</p>

                <h2>Cuadro de honor</h2>

            </div>

            <div class="ranking-podio">

                @for (int i = 0; i < Math.Min(Model.Count, 3); i++)
                {
                    var partida = Model[i];
                    int posicion = i + 1;

                    string clase = posicion == 1
                    ? "ranking-oro"
                    : posicion == 2
                    ? "ranking-plata"
                    : "ranking-bronce";

                    string medalla = posicion == 1
                    ? "🥇"
                    : posicion == 2
                    ? "🥈"
                    : "🥉";

                    <div class="ranking-podio-tarjeta @clase">

                        <div class="ranking-medalla">
                            @medalla
                        </div>

                        <p class="ranking-posicion">
                            PUESTO #@posicion
                        </p>

                        <h3>@partida.NombreJugador</h3>

                        <div class="ranking-podio-puntos">
                            @partida.Puntaje
                        </div>

                        <span class="ranking-podio-pts">
                            PUNTOS
                        </span>

                        <div class="ranking-podio-linea"></div>

                        <p class="ranking-podio-aciertos">
                            @partida.Aciertos de
                            @partida.TotalPreguntas aciertos
                        </p>

                        <p class="ranking-podio-fecha">
                            @partida.FechaRegistro.ToString("dd/MM/yyyy")
                        </p>

                    </div>
                }

            </div>

            <!-- CLASIFICACIÓN RESTANTE -->
            @if (Model.Count > 3)
            {
                <div class="ranking-seccion-titulo">

                    <p>CLASIFICACIÓN GENERAL</p>

                    <h2>Más resultados destacados</h2>

                </div>

                <div class="ranking-tabla-contenedor">

                    <table class="ranking-tabla">

                        <thead>
                            <tr>
                                <th>POSICIÓN</th>
                                <th>JUGADOR</th>
                                <th>ACIERTOS</th>
                                <th>PUNTUACIÓN</th>
                                <th>FECHA (UTC)</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (int i = 3; i < Model.Count; i++)
                            {
                                var partida = Model[i];
                                int posicion = i + 1;

                                <tr>
                                    <td>
                                        <span class="ranking-numero">
                                            @posicion
                                        </span>
                                    </td>

                                    <td class="ranking-nombre">
                                        @partida.NombreJugador
                                    </td>

                                    <td>
                                        @partida.Aciertos /
                                        @partida.TotalPreguntas
                                    </td>

                                    <td>
                                        <strong>
                                            @partida.Puntaje
                                        </strong>
                                        <span class="ranking-pts">
                                            PTS
                                        </span>
                                    </td>

                                    <td>
                                        @partida.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            <!-- INFORMACIÓN -->
            <div class="ranking-informacion">

                <div>
                    <span>10</span>
                    <p>Preguntas por partida</p>
                </div>

                <div>
                    <span>15s</span>
                    <p>Por pregunta</p>
                </div>

                <div>
                    <span>100</span>
                    <p>Puntos por acierto</p>
                </div>

            </div>

        }

        <!-- BOTONES -->
        <div class="ranking-acciones">

            <a asp-controller="Juego"
               asp-action="Index"
               class="ranking-boton">

                JUGAR AHORA
                <span aria-hidden="true">→</span>

            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="ranking-boton-secundario">

                VOLVER AL INICIO

            </a>

        </div>

        <p class="ranking-pie">
            CADA DESAFÍO ES UNA OPORTUNIDAD PARA SUPERARTE
        </p>

    </div>

</section>

<style>

    /* =========================================
           RANKING - ESTILOS GENERALES
           ========================================= */

    .ranking {
        min-height: 85vh;
        padding: 70px 20px;
        background: linear-gradient( 120deg, #f5f0e8 0%, #ebdfcb 100% );
    }

    .ranking-contenedor {
        width: 100%;
        max-width: 1150px;
        margin: 0 auto;
    }

    /* =========================================
           ENCABEZADO
           ========================================= */

    .ranking-encabezado {
        text-align: center;
        margin-bottom: 65px;
    }

    .ranking-icono {
        font-size: 50px;
        color: #a7834e;
        margin-bottom: 15px;
    }

    .ranking-etiqueta {
        color: #987b50;
        font-size: 12px;
        letter-spacing: 3px;
        margin-bottom: 20px;
    }

    .ranking-encabezado h1 {
        color: #14212b;
        font-size: clamp(36px, 6vw, 65px);
        line-height: 1.2;
        font-weight: 500;
        margin-bottom: 25px;
    }

        .ranking-encabezado h1 span {
            display: block;
            color: #a7834e;
        }

    .ranking-descripcion {
        max-width: 650px;
        margin: 0 auto;
        color: #666666;
        font-size: 17px;
        line-height: 1.8;
    }

    /* =========================================
           TÍTULOS DE SECCIÓN
           ========================================= */

    .ranking-seccion-titulo {
        text-align: center;
        margin-bottom: 35px;
    }

        .ranking-seccion-titulo p {
            color: #987b50;
            font-size: 11px;
            letter-spacing: 3px;
            margin-bottom: 12px;
        }

        .ranking-seccion-titulo h2 {
            color: #14212b;
            font-size: 32px;
            font-weight: 500;
        }

    /* =========================================
           PODIO
           ========================================= */

    .ranking-podio {
        display: grid;
        grid-template-columns: repeat( 3, minmax(0, 1fr) );
        gap: 20px;
        margin-bottom: 70px;
    }

    .ranking-podio-tarjeta {
        background: #ffffff;
        border: 1px solid #e2d5c0;
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        box-shadow: 0 12px 35px rgba( 20, 33, 43, 0.06 );
        transition: transform 0.3s ease;
    }

        .ranking-podio-tarjeta:hover {
            transform: translateY(-6px);
        }

    .ranking-oro {
        border: 2px solid #c4a15e;
        background: linear-gradient( 180deg, #fffaf0 0%, #ffffff 100% );
    }

    .ranking-plata {
        border-top: 4px solid #a9adb3;
    }

    .ranking-bronce {
        border-top: 4px solid #b77c50;
    }

    .ranking-medalla {
        font-size: 45px;
        margin-bottom: 20px;
    }

    .ranking-posicion {
        color: #987b50;
        font-size: 11px;
        letter-spacing: 2px;
        margin-bottom: 15px;
    }

    .ranking-podio-tarjeta h3 {
        color: #14212b;
        font-size: 24px;
        font-weight: 500;
        margin-bottom: 20px;
        overflow-wrap: anywhere;
    }

    .ranking-podio-puntos {
        color: #14212b;
        font-size: 55px;
        line-height: 1.2;
    }

    .ranking-podio-pts {
        color: #a7834e;
        font-size: 12px;
        letter-spacing: 3px;
    }

    .ranking-podio-linea {
        width: 45px;
        height: 2px;
        background: #a7834e;
        margin: 25px auto;
    }

    .ranking-podio-aciertos {
        color: #565656;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .ranking-podio-fecha {
        color: #987b50;
        font-size: 12px;
        margin: 0;
    }

    /* =========================================
           TABLA DE CLASIFICACIÓN
           ========================================= */

    .ranking-tabla-contenedor {
        background: #ffffff;
        border: 1px solid #e2d5c0;
        border-radius: 12px;
        overflow-x: auto;
        margin-bottom: 50px;
        box-shadow: 0 10px 30px rgba( 20, 33, 43, 0.05 );
    }

    .ranking-tabla {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
    }

        .ranking-tabla thead {
            background: #14212b;
        }

        .ranking-tabla th {
            padding: 22px 18px;
            color: #ffffff;
            font-size: 11px;
            letter-spacing: 1px;
            text-align: left;
            font-weight: 500;
        }

        .ranking-tabla td {
            padding: 20px 18px;
            border-bottom: 1px solid #eee5d8;
            color: #565656;
            font-size: 14px;
        }

        .ranking-tabla tbody tr:last-child td {
            border-bottom: none;
        }

        .ranking-tabla tbody tr:hover {
            background: #faf7f1;
        }

    .ranking-numero {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #f0e6d6;
        color: #987b50;
        font-size: 15px;
    }

    .ranking-nombre {
        color: #14212b !important;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .ranking-tabla td strong {
        color: #14212b;
        font-size: 19px;
    }

    .ranking-pts {
        color: #987b50;
        font-size: 10px;
        margin-left: 5px;
    }

    /* =========================================
           INFORMACIÓN DEL JUEGO
           ========================================= */

    .ranking-informacion {
        display: flex;
        justify-content: center;
        gap: 60px;
        flex-wrap: wrap;
        margin-bottom: 55px;
        text-align: center;
    }

        .ranking-informacion span {
            display: block;
            color: #14212b;
            font-size: 34px;
            margin-bottom: 10px;
        }

        .ranking-informacion p {
            color: #987b50;
            font-size: 12px;
        }

    /* =========================================
           RANKING VACÍO
           ========================================= */

    .ranking-vacio {
        background: #ffffff;
        border: 1px solid #e2d5c0;
        border-radius: 12px;
        padding: 60px 25px;
        text-align: center;
        margin-bottom: 40px;
    }

    .ranking-vacio-icono {
        font-size: 55px;
        color: #a7834e;
        margin-bottom: 25px;
    }

    .ranking-vacio h2 {
        color: #14212b;
        font-size: 28px;
        margin-bottom: 15px;
    }

    .ranking-vacio p {
        color: #666666;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    /* =========================================
           BOTONES
           ========================================= */

    .ranking-acciones {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .ranking-boton,
    .ranking-boton-secundario {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        min-width: 220px;
        padding: 18px 25px;
        border-radius: 6px;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 13px;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .ranking-boton {
        background: #14212b;
        color: #ffffff;
        border: 1px solid #14212b;
    }

        .ranking-boton:hover {
            background: #a7834e;
            border-color: #a7834e;
            color: #ffffff;
        }

    .ranking-boton-secundario {
        background: transparent;
        color: #14212b;
        border: 1px solid #a7834e;
    }

        .ranking-boton-secundario:hover {
            background: #f1e8d9;
            color: #14212b;
        }

        .ranking-boton:focus-visible,
        .ranking-boton-secundario:focus-visible {
            outline: 2px solid #a7834e;
            outline-offset: 3px;
        }

    .ranking-pie {
        text-align: center;
        color: #987b50;
        font-size: 11px;
        letter-spacing: 2px;
        margin-top: 40px;
    }

    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 768px) {

        .ranking {
            padding: 40px 15px;
        }

        .ranking-podio {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .ranking-podio-tarjeta {
            padding: 30px 20px;
        }

        .ranking-informacion {
            gap: 25px;
        }

        .ranking-acciones {
            flex-direction: column;
        }

        .ranking-boton,
        .ranking-boton-secundario {
            width: 100%;
        }
    }
</style>
